<%- include('_head', { title }) %>

<header class="border-b border-slate-800 bg-slate-950">
  <div class="mx-auto max-w-5xl px-4 py-5">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-400">
      Arte Fotográfico
    </p>

    <h1 class="mt-1 text-xl font-bold text-white">
      Importación finalizada
    </h1>
  </div>
</header>

<main class="mx-auto max-w-5xl space-y-6 p-4">

  <!-- Progreso -->
  <section class="rounded-2xl border border-slate-700 bg-slate-900/80 p-4">
    <div class="grid gap-3 text-center text-xs sm:grid-cols-4">

      <div class="rounded-xl bg-emerald-500/20 px-3 py-3 font-bold text-emerald-300">
        ✓ 1. PDF
      </div>

      <div class="rounded-xl bg-emerald-500/20 px-3 py-3 font-bold text-emerald-300">
        ✓ 2. Alumnos
      </div>

      <div class="rounded-xl bg-emerald-500/20 px-3 py-3 font-bold text-emerald-300">
        ✓ 3. Configuración
      </div>

      <div class="rounded-xl bg-emerald-600 px-3 py-3 font-bold text-white">
        ✓ 4. Importado
      </div>

    </div>
  </section>

  <section class="overflow-hidden rounded-2xl border border-emerald-500/30 bg-slate-900/80">

    <div class="border-b border-slate-700 bg-emerald-500/10 p-6 text-center">
      <div class="text-5xl">
        ✅
      </div>

      <h2 class="mt-3 text-2xl font-extrabold text-white">
        Importación completada
      </h2>

      <p class="mt-2 text-sm text-slate-300">
        <%= institucion %> — <%= grado %>, sección <%= seccion %>
      </p>
    </div>

    <div class="grid gap-4 p-6 sm:grid-cols-3">

      <div class="rounded-2xl border border-slate-700 bg-slate-950/50 p-5 text-center">
        <p class="text-xs font-bold uppercase text-slate-500">
          Recibidos
        </p>

        <p class="mt-2 text-3xl font-extrabold text-white">
          <%= totalRecibidos %>
        </p>
      </div>

      <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-5 text-center">
        <p class="text-xs font-bold uppercase text-emerald-300">
          Órdenes creadas
        </p>

        <p class="mt-2 text-3xl font-extrabold text-emerald-300">
          <%= importados %>
        </p>
      </div>

      <div class="rounded-2xl border border-amber-500/30 bg-amber-500/10 p-5 text-center">
        <p class="text-xs font-bold uppercase text-amber-300">
          Duplicados omitidos
        </p>

        <p class="mt-2 text-3xl font-extrabold text-amber-300">
          <%= duplicados %>
        </p>
      </div>

    </div>
  </section>

  <% if (nombresDuplicados && nombresDuplicados.length) { %>

    <details class="rounded-2xl border border-amber-500/30 bg-slate-900/80">
      <summary class="cursor-pointer px-5 py-4 text-sm font-bold text-amber-300">
        Ver alumnos duplicados omitidos
      </summary>

      <div class="border-t border-slate-700 p-5">
        <ol class="space-y-2 text-sm text-slate-300">
          <% nombresDuplicados.forEach(function(nombre, index) { %>
            <li class="rounded-lg bg-slate-950/50 px-3 py-2">
              <span class="mr-2 text-slate-500">
                <%= index + 1 %>.
              </span>

              <%= nombre %>
            </li>
          <% }) %>
        </ol>
      </div>
    </details>

  <% } %>

  <div class="flex flex-col gap-3 sm:flex-row sm:justify-center">

    <a
      href="/admin/ordenes/instituciones/importar"
      class="inline-flex items-center justify-center rounded-xl border border-slate-600 px-5 py-3 text-sm font-bold text-slate-200 transition hover:bg-slate-800"
    >
      📥 Importar otro listado
    </a>

    <a
      href="/admin/ordenes?tab=instituciones"
      class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-emerald-500"
    >
      Ver órdenes creadas →
    </a>

  </div>
</main>

<%- include('_foot') %>