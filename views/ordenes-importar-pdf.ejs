<%- include('_head', { title }) %>

<header class="border-b border-slate-800 bg-slate-950">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-400">
        Arte Fotográfico
      </p>

      <h1 class="mt-1 text-xl font-bold text-white">
        Importar listado institucional
      </h1>
    </div>

    <a
      href="/admin/ordenes?tab=instituciones"
      class="text-sm font-semibold text-slate-300 transition hover:text-white"
    >
      ← Volver
    </a>
  </div>
</header>

<main class="mx-auto max-w-5xl space-y-6 p-4">

  <!-- Progreso -->
  <section class="rounded-2xl border border-slate-700 bg-slate-900/80 p-4">
    <div class="grid gap-3 text-center text-xs sm:grid-cols-4">

      <div class="rounded-xl bg-emerald-600 px-3 py-3 font-bold text-white">
        1. Seleccionar PDF
      </div>

      <div class="rounded-xl bg-slate-800 px-3 py-3 font-semibold text-slate-400">
        2. Revisar alumnos
      </div>

      <div class="rounded-xl bg-slate-800 px-3 py-3 font-semibold text-slate-400">
        3. Configurar orden
      </div>

      <div class="rounded-xl bg-slate-800 px-3 py-3 font-semibold text-slate-400">
        4. Importar
      </div>

    </div>
  </section>

  <% if (error) { %>
    <div class="rounded-2xl border border-red-500/30 bg-red-500/10 p-4 text-sm font-semibold text-red-300">
      ⚠️ <%= error %>
    </div>
  <% } %>

  <section class="overflow-hidden rounded-2xl border border-slate-700 bg-slate-900/80">

    <div class="border-b border-slate-700 px-6 py-5">
      <h2 class="text-lg font-bold text-white">
        📥 Selecciona el listado
      </h2>

      <p class="mt-1 text-sm text-slate-400">
        Utiliza un PDF que contenga texto seleccionable. Más adelante agregaremos soporte para listados escaneados.
      </p>
    </div>

    <form
      action="/admin/ordenes/instituciones/importar/preview"
      method="POST"
      enctype="multipart/form-data"
      class="space-y-5 p-6"
      id="formImportarPdf"
    >

      <label
        for="archivo_pdf"
        class="group flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-600 bg-slate-950/50 px-6 py-12 text-center transition hover:border-emerald-500 hover:bg-emerald-500/5"
      >
        <div class="text-5xl">
          📄
        </div>

        <p class="mt-4 text-base font-bold text-white">
          Seleccionar archivo PDF
        </p>

        <p class="mt-1 text-sm text-slate-400">
          Tamaño máximo: 15 MB
        </p>

        <p
          id="nombreArchivo"
          class="mt-4 hidden rounded-full bg-emerald-500/15 px-4 py-2 text-sm font-semibold text-emerald-300"
        ></p>

        <input
          type="file"
          id="archivo_pdf"
          name="archivo_pdf"
          accept=".pdf,application/pdf"
          required
          class="sr-only"
        >
      </label>

      <div class="rounded-xl border border-amber-500/20 bg-amber-500/10 p-4">
        <h3 class="text-sm font-bold text-amber-300">
          Antes de continuar
        </h3>

        <p class="mt-1 text-xs leading-5 text-slate-300">
          El sistema mostrará una vista previa. Ningún alumno será guardado automáticamente durante este paso.
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">

        <a
          href="/admin/ordenes?tab=instituciones"
          class="inline-flex items-center justify-center rounded-xl border border-slate-600 px-5 py-3 text-sm font-bold text-slate-200 transition hover:bg-slate-800"
        >
          Cancelar
        </a>

        <button
          type="submit"
          id="btnProcesar"
          class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-emerald-500 disabled:cursor-not-allowed disabled:opacity-60"
        >
          Analizar PDF →
        </button>

      </div>
    </form>
  </section>
</main>

<script>
  const inputPdf = document.getElementById('archivo_pdf');
  const nombreArchivo = document.getElementById('nombreArchivo');
  const formulario = document.getElementById('formImportarPdf');
  const btnProcesar = document.getElementById('btnProcesar');

  inputPdf.addEventListener('change', function () {
    const archivo = this.files && this.files[0];

    if (!archivo) {
      nombreArchivo.textContent = '';
      nombreArchivo.classList.add('hidden');
      return;
    }

    nombreArchivo.textContent = '✓ ' + archivo.name;
    nombreArchivo.classList.remove('hidden');
  });

  formulario.addEventListener('submit', function () {
    btnProcesar.disabled = true;
    btnProcesar.textContent = 'Procesando PDF...';
  });
</script>

<%- include('_foot') %>